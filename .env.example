# API Keys
OPENAI_API_KEY=your_openai_api_key_here
USDA_API_KEY=your_usda_api_key_here
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Configuración
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here

# Configuración de servidor
PORT=8080
HOST=0.0.0.0

# Opciones de optimización
DEFAULT_GENERATIONS=50
DEFAULT_POPULATION_SIZE=100
DEFAULT_VALIDATION_SEVERITY=MEDIUM

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pizzaai
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Límites de ingredientes para validación
MAX_HYDRATION_RATIO=80
MIN_HYDRATION_RATIO=50
IDEAL_HYDRATION_RATIO=65

MAX_SALT_PERCENTAGE=2.5
MIN_SALT_PERCENTAGE=1.5
IDEAL_SALT_PERCENTAGE=2.0

MAX_YEAST_PERCENTAGE=2.0
MIN_YEAST_PERCENTAGE=0.5
IDEAL_YEAST_PERCENTAGE=1.0

# Herramientas y monitoreo
GRAFANA_ADMIN_PASSWORD=change_me_in_production