        "temperature_adjustments": {"reduce_by": 10, "unit": "C"}
      }
    },
    "texture_control": {
      "elastic": {
        "key_ingredients": ["gluten", "psyllium", "xanthan_gum"],
        "mixing_requirements": {"longer": true, "temperature_sensitive": true}
      },
      "crispy": {
        "key_ingredients": ["starch", "low_hydration"],
        "baking_requirements": {"higher_temperature": true, "longer_time": false}
      },
      "fluffy": {
        "key_ingredients": ["high_hydration", "proper_leavening"],
        "mixing_requirements": {"gentler": true},
        "fermentation_requirements": {"longer": true}
      }
    }
