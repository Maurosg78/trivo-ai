      },
      "tolerances": {
        "hydration": {"range": 1, "unit": "%"},
        "salt": {"range": 0.1, "unit": "%"},
        "temperature": {"range": 1, "unit": "C"}
      },
      "quality_control": {
        "check_points": ["mixing", "fermentation", "baking", "cooling"],
        "parameters": [
          {"name": "dough_temperature", "tolerance": 1.0},
          {"name": "dough_pH", "tolerance": 0.2},
          {"name": "moisture_content", "tolerance": 1.0},
          {"name": "dough_consistency", "tolerance": 20, "unit": "BU"}
        ]
      }
    }
  },
  "recipe_types": {
    "pizza": {
      "hydration_range": {"min": 55, "max": 70, "unit": "%"},
